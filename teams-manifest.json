{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.16/MicrosoftTeams.schema.json",
  "manifestVersion": "1.16",
  "version": "1.0.0",
  "id": "{{TEAMS_APP_ID}}",
  "packageName": "com.ingenierialegal.observatorio",
  "developer": {
    "name": "Ingeniería Legal SAS",
    "websiteUrl": "https://{{APP_URL}}",
    "privacyUrl": "https://{{APP_URL}}/privacy",
    "termsOfUseUrl": "https://{{APP_URL}}/terms"
  },
  "icons": {
    "color": "icon-color.png",
    "outline": "icon-outline.png"
  },
  "name": {
    "short": "Observatorio INM",
    "full": "Observatorio Inmobiliario GIS"
  },
  "description": {
    "short": "Sistema de análisis y visualización inmobiliaria",
    "full": "Observatorio Inmobiliario con capacidades GIS para análisis de mercado, ofertas inmobiliarias y visualización cartográfica de datos"
  },
  "accentColor": "#10b981",
  "configurableTabs": [
    {
      "configurationUrl": "https://{{APP_URL}}/config.html",
      "canUpdateConfiguration": true,
      "scopes": [
        "team",
        "groupchat"
      ]
    }
  ],
  "staticTabs": [
    {
      "entityId": "observatorio-main",
      "name": "Observatorio",
      "contentUrl": "https://{{APP_URL}}/index.html",
      "websiteUrl": "https://{{APP_URL}}/",
      "scopes": [
        "personal"
      ]
    }
  ],
  "permissions": [
    "identity",
    "messageTeamMembers"
  ],
  "validDomains": [
    "{{APP_URL_DOMAIN}}",
    "*.azurewebsites.net"
  ],
  "webApplicationInfo": {
    "id": "{{TEAMS_APP_ID}}",
    "resource": "https://{{APP_URL}}"
  }
}
